<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>鎌倉パーソナル観光ルート｜属性選択</title>
</head>
<body>
  <main>
    <h1>鎌倉パーソナル観光ルートサイト</h1>
    <p>あなたに合った観光ルートを提案します！</p>

    <form>
      <!-- 国籍 -->
      <div class="field">
        <label for="nationality">国籍</label>
        <select id="nationality" name="nationality" required>
          <option value="">選択してください</option>
          <option value="jp">日本</option>
          <option value="us">アメリカ</option>
          <option value="cn">中国</option>
          <option value="other">その他</option>
        </select>
      </div>

      <!-- 年代 -->
      <div class="field">
        <label for="age">年代</label>
        <select id="age" name="age" required>
          <option value="">選択してください</option>
          <option value="teens">10代以下</option>
          <option value="20s">20代</option>
          <option value="30s">30代</option>
          <option value="40s">40代</option>
          <option value="50s">50代以上</option>
        </select>
      </div>

      <!-- 同行者 -->
      <div class="field">
        <label for="companions">同行者</label>
        <select id="companions" name="companions" required>
          <option value="">選択してください</option>
          <option value="solo">ひとり旅</option>
          <option value="couple">カップル</option>
          <option value="family">家族</option>
          <option value="friends">友人</option>
          <option value="group">グループ</option>
        </select>
      </div>

      <!-- 滞在時間 -->
      <div class="field">
        <label for="stay">滞在時間</label>
        <select id="stay" name="stay" required>
          <option value="">選択してください</option>
          <option value="daytrip">日帰り</option>
          <option value="1n2d">1泊2日</option>
          <option value="2n3d">2泊3日</option>
          <option value="3nplus">3泊以上</option>
        </select>
      </div>

      <!-- 興味のあるジャンル -->
      <div class="field">
        <label for="interests">興味のあるジャンル</label>
        <select id="interests" name="interests" required>
          <option value="">選択してください</option>
          <option value="temples">歴史・寺社・文化</option>
          <option value="nature">自然・景観</option>
          <option value="food">グルメ・カフェ</option>
          <option value="souvenir">お土産・雑貨</option>
          <option value="activity">体験・アクテビティ</option>
        </select>
      </div>

      <!-- 送信ボタン -->
      <div class="actions">
        <button type="submit">完了</button>
      </div>
    </form>
  </main>
</body>
</html>
