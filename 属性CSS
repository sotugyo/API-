@charset "UTF-8";

/* フォーム全体の枠 */
form {
  width: 350px;
  margin: 30px auto;
  padding: 20px;
  border: 1px solid #ccc;       /* 薄い枠線 */
  border-radius: 10px;          /* 角を丸める */
  background-color: #f9f9f9;    /* 薄い背景色 */
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); /* 影をつける */
}

/* ラベルのデザイン */
form label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
  color: #333;
}

/* テキスト入力やパスワード入力の共通デザイン */
form input[type="text"],
form input[type="password"],
form input[type="email"],
form input[type="number"] {
  width: 100%;
  padding: 10px;
  margin-bottom: 15px;
  border: 1px solid #ccc;
  border-radius: 5px;
  box-sizing: border-box;
  font-size: 14px;
}

/* 入力欄にフォーカスしたとき */
form input:focus {
  border-color: #66aaff;
  outline: none;
  box-shadow: 0 0 5px rgba(102, 170, 255, 0.5);
}

/* ボタンのデザイン */
form input[type="submit"],
form button {
  width: 100%;
  padding: 12px;
  background-color: #4CAF50;   /* 緑 */
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  cursor: pointer;
  transition: background-color 0.3s;
}

/* ボタンのホバー */
form input[type="submit"]:hover,
form button:hover {
  background-color: #45a049;
}
