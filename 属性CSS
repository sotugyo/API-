@charset "UTF-8";

/* フォーム全体 */
form {
  width: 400px;
  margin: 40px auto;
  padding: 25px;
  border: 1px solid #ddd;
  border-radius: 12px;
  background-color: #fffaf5;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  font-family: "Yu Gothic", "Hiragino Sans", sans-serif;
}

/* タイトル */
form h2 {
  text-align: center;
  margin-bottom: 25px;
  font-size: 26px;
  color: #0066cc; /* 青めの色でアクセント */
  font-weight: bold;
  border-bottom: 2px solid #0066cc;
  display: inline-block;
  padding-bottom: 6px;
}

/* ラベル */
form label {
  display: block;
  margin-bottom: 6px;
  font-weight: bold;
  color: #444;
  font-size: 15px;
}

/* 入力フィールド・セレクト */
form input[type="text"],
form input[type="email"],
form input[type="number"],
form select {
  width: 100%;
  padding: 14px; /* 少し大きめ */
  margin-bottom: 20px;
  border: 1px solid #ccc;
  border-radius: 6px;
  box-sizing: border-box;
  font-size: 15px;
  background-color: #fff;
  transition: all 0.2s;
}

/* 入力時の強調 */
form input:focus,
form select:focus {
  border-color: #3399ff;
  box-shadow: 0 0 6px rgba(51, 153, 255, 0.4);
  outline: none;
}

/* ラジオボタンやチェックボックスのグループ */
.option-group {
  margin-bottom: 20px;
  font-size: 15px;
}

.option-group label {
  font-weight: normal;
  margin-right: 18px;
  cursor: pointer;
}

/* ボタン */
form button,
form input[type="submit"] {
  width: 100%;
  padding: 14px;
  background-color: #4da6ff; /* 明るめの青（タップ前） */
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 17p
}

